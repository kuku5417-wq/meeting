# meeting 이 읽는 키 — 값은 상위 폴더 secret/.env 에 넣는다(이 파일엔 이름만).
# 공통 키(NAS_BASE_PATH, DATA_PATH, HTTP_PROXY, LLM_SOLAR_* 등)는 secret/.env 를 그대로 쓴다.

# 경로 — 데이터(meeting.db·photos·exports) 저장 위치
#   MEETING_DATA_PATH 를 넣으면 그 폴더를 그대로 쓴다(NAS 무시). 운영 PC 로컬 디스크 권장.
#     예) MEETING_DATA_PATH=D:\meeting_data    또는    MEETING_DATA_PATH=%LOCALAPPDATA%\meeting
#   비우면 <NAS_BASE_PATH 또는 DATA_PATH>/meeting → 둘 다 없으면 code_N/data/meeting
#   바꾼 뒤에는 서버를 다시 켠다. 기존 데이터는 옛 폴더의 meeting.db·photos·exports 를 새 폴더로 복사한다.
NAS_BASE_PATH=
DATA_PATH=
MEETING_DATA_PATH=
# 중앙 parquet(pjtlist·milestone, 읽기 전용) 폴더 — 비우면 NAS_PARQUET_PATH → NAS_BASE_PATH/parquet → DATA_PATH/parquet
MEETING_CENTRAL_PARQUET=
# 운영 DB 전환 시에만 (비우면 데이터 폴더의 SQLite)
MEETING_DATABASE_URL=

# LLM 공급자 체인 — 비우면 sola,upstage,openai,mock (테스트 단계). 외부 차단은 sola,mock (docs/04)
# 키는 공통 LLM_SOLAR_* / LLM_UPSTAGE_* / LLM_OPENAI_* 를 그대로 쓴다
MEETING_LLM_CHAIN=
MEETING_LLM_TIMEOUT_SEC=

# 업무 설정 (장기 미결 기준 주 수, 기본 4)
MEETING_LONG_OPEN_WEEKS=

# 메일 수집(가져오기 화면 「메일함에서 가져오기」) — 서버 PC 클래식 Outlook 의 받은편지함 아래 폴더 경로
#   예) MEETING_MAIL_FOLDER=회의자료      (비우면 메일함 입구를 끈다. pywin32·Outlook 이 없어도 앱은 뜬다)
MEETING_MAIL_FOLDER=
MEETING_MAIL_DAYS=
MEETING_IMPORT_MAX_MB=
